# ==============================================================================
# Medliva Environment Configuration (Cloud-First: Supabase)
# ==============================================================================

ENV=dev
CORS_ORIGINS=["http://localhost:3000"]

# --- Supabase Auth ---
SUPABASE_URL=https://bapyzkwbkkyilgueaftc.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- Database (Supabase PostgreSQL) ---
# Long-lived FastAPI server: direct PostgreSQL connection (IPv6). Use the Session Pooler from Dashboard > Connect if the host is IPv4-only.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DATABASE_PASSWORD@db.bapyzkwbkkyilgueaftc.supabase.co:5432/postgres

# --- Optional cache (not required for the MVP) ---
# Example: rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# --- Optional Object Storage (Supabase Storage / S3 Compatible) ---
# Project Settings -> Storage -> S3 Access Keys in Supabase Dashboard
S3_ENDPOINT=https://bapyzkwbkkyilgueaftc.supabase.co/storage/v1/s3
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_BUCKET=medliva
S3_REGION=auto

# --- AI Layer ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Push Notifications (Optional for later sprints) ---
FCM_CREDENTIALS_PATH=
