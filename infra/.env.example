#
# Medliva Environment Configuration (Cloud-First: Supabase)
#
# Copy this file to infra/.env and fill in YOUR values.
# Nothing in this file should ever contain a real key or password.
#

# --- Required ---
ENV=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Supabase Auth (required) ---
SUPABASE_URL=https://YOUR_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy fallback name, used only if SUPABASE_PUBLISHABLE_KEY is empty:
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Database (Supabase PostgreSQL) ---
# Long-lived FastAPI server: direct PostgreSQL connection (IPv6). Use the Session Pooler from Dashboard > Connect if the host is IPv4-only.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres

# --- Optional local Postgres (only for infra/docker-compose.yml) ---
POSTGRES_USER=medliva
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=medliva

# --- AI Layer (optional; prescription OCR falls back without it) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Currently unused by services/api/app (leave empty unless implemented) ---
# REDIS_URL is read as a setting but no code uses it yet.
REDIS_URL=
# S3_* / FCM_* are not used by the current code: there is no S3 client and
# no server-side push sender in services/api/app. They are kept here only
# so future work has a place to document them; do not put real values in
# unless the corresponding feature is actually implemented.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
FCM_CREDENTIALS_PATH=
